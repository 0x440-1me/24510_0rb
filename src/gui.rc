#include <windows.h>
#include "resource.h"
1 RT_MANIFEST "app.manifest"
IDI_ORB ICON "src/assets/ribbon.ico"
IDD_RESTART DIALOGEX 0,0,350,142
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Restart Discord to connect?"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "",ID_CONFIRM_TEXT,16,16,318,74
 PUSHBUTTON "Restart & Connect",IDOK,140,108,105,22
 DEFPUSHBUTTON "Cancel",IDCANCEL,252,108,82,22
END
IDD_ORIGINAL DIALOGEX 0,0,570,380
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Original Orb (experimental) - Import and review"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "The original self-starting script automatically enrolls/updates quests and fakes activity using your authenticated Discord client. It may violate Discord rules. Author: 0x440_1me; owner-authorized bundle, excluded from MIT. See legacy/NOTICE.md.", -1,12,10,546,38
 PUSHBUTTON "Select local .js...",ID_ORB_SELECT,12,52,112,22
 PUSHBUTTON "Use original",ID_ORB_DEFAULT,132,52,112,22
 LTEXT "",ID_ORB_INFO,12,82,546,42
 EDITTEXT ID_ORB_SOURCE,12,128,546,210,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
 PUSHBUTTON "Review and run...",IDOK,340,348,122,22
 DEFPUSHBUTTON "Close",IDCANCEL,470,348,88,22
END
IDD_SCRIPT_CONFIRM DIALOGEX 0,0,470,224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm this run"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "",ID_CONFIRM_TEXT,14,14,442,158
 PUSHBUTTON "Run these bytes",IDOK,238,186,126,24
 DEFPUSHBUTTON "Cancel",IDCANCEL,372,186,84,24
END
IDD_SETTINGS DIALOGEX 0,0,480,426
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings / Advanced"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Debugging port",-1,14,16,126,12
 EDITTEXT ID_PORT_EDIT,146,12,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Operation timeout (ms)",-1,14,44,126,12
 EDITTEXT ID_OPERATION_EDIT,146,40,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Graceful exit timeout (ms)",-1,14,72,126,12
 EDITTEXT ID_EXIT_EDIT,146,68,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Renderer wait timeout (ms)",-1,14,100,126,12
 EDITTEXT ID_ENDPOINT_EDIT,146,96,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Discord executable (blank: automatic selection)",-1,14,128,400,12
 EDITTEXT ID_DISCORD_EDIT,14,144,350,20,ES_AUTOHSCROLL | ES_READONLY
 PUSHBUTTON "Browse...",ID_SETTINGS_DISCORD_BROWSE,374,144,90,20
 LTEXT "Selected JavaScript file",-1,14,176,400,12
 EDITTEXT ID_SCRIPT_EDIT,14,192,350,20,ES_AUTOHSCROLL | ES_READONLY
 PUSHBUTTON "Browse...",ID_SETTINGS_SCRIPT_BROWSE,374,192,90,20
 CONTROL "Passive connection check on startup (no Quest requests)",ID_SETTINGS_AUTO_CONNECT,"BUTTON",BS_AUTOCHECKBOX|WS_TABSTOP,14,224,448,16
 CONTROL "Allow read-only Quest checks while running (logged-in client)",ID_SETTINGS_SCAN,"BUTTON",BS_AUTOCHECKBOX|WS_TABSTOP,14,248,448,16
 GROUPBOX "Advanced diagnostics - no automatic script execution",-1,14,278,450,72
 PUSHBUTTON "Check connection",ID_SETTINGS_CONNECT,24,300,128,22
 PUSHBUTTON "Restart with consent...",ID_SETTINGS_RESTART,164,300,140,22
 PUSHBUTTON "Original Orb / Review...",ID_SETTINGS_ORIGINAL,314,300,138,22
 PUSHBUTTON "Run selected script...",ID_SETTINGS_RUN,24,326,128,20
 PUSHBUTTON "Cancel helper only",ID_SETTINGS_CANCEL,164,326,140,20
 LTEXT "",ID_SETTINGS_ERROR,14,360,450,22
 DEFPUSHBUTTON "Save",IDOK,278,394,82,22
 PUSHBUTTON "Cancel",IDCANCEL,374,394,90,22
END
#include "version.rc"
