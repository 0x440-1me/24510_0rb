#include <windows.h>
#include "resource.h"
1 RT_MANIFEST "app.manifest"
IDD_RESTART DIALOGEX 0,0,350,142
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Restart Discord"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "",ID_CONFIRM_TEXT,16,16,318,74
 PUSHBUTTON "Restart Discord",IDOK,140,108,105,22
 DEFPUSHBUTTON "Cancel",IDCANCEL,252,108,82,22
END
IDD_SETTINGS DIALOGEX 0,0,430,280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Debugging port",-1,14,16,126,12
 EDITTEXT ID_PORT_EDIT,146,12,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Operation timeout (ms)",-1,14,44,126,12
 EDITTEXT ID_OPERATION_EDIT,146,40,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Graceful exit timeout (ms)",-1,14,72,126,12
 EDITTEXT ID_EXIT_EDIT,146,68,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Renderer wait timeout (ms)",-1,14,100,126,12
 EDITTEXT ID_ENDPOINT_EDIT,146,96,82,20,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Discord executable (blank: automatic selection)",-1,14,128,400,12
 EDITTEXT ID_DISCORD_EDIT,14,144,402,20,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Selected JavaScript file",-1,14,176,400,12
 EDITTEXT ID_SCRIPT_EDIT,14,192,402,20,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "",ID_SETTINGS_ERROR,14,220,402,22
 DEFPUSHBUTTON "Save",IDOK,240,248,82,22
 PUSHBUTTON "Cancel",IDCANCEL,334,248,82,22
END
